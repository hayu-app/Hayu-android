<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hayu_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_home_header">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Profil"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- FOTO PROFIL -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:id="@+id/btn_change_photo">

            <ImageView
                android:id="@+id/img_edit_avatar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_profile"
                android:background="@drawable/bg_input"
                android:padding="24dp"
                android:contentDescription="Foto Profil" />

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="📷"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_button_primary"
                android:layout_gravity="bottom|end" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap untuk ubah foto"
            android:textColor="@color/hayu_text_secondary"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <!-- NAMA PANGGILAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Panggilan"
            android:textColor="@color/hayu_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/et_edit_nickname"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Nama panggilan"
                android:textColorHint="@color/hayu_text_secondary"
                android:textColor="@color/hayu_text"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:inputType="textPersonName"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- UMUR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Umur"
            android:textColor="@color/hayu_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎂"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/et_edit_age"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Umur"
                android:textColorHint="@color/hayu_text_secondary"
                android:textColor="@color/hayu_text"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:inputType="number"
                android:maxLength="2"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- GENDER (READ-ONLY) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jenis Kelamin"
            android:textColor="@color/hayu_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_edit_gender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="♂️ Pria"
                android:textColor="@color/hayu_text"
                android:textSize="14sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ⓘ Tidak dapat diubah"
            android:textColor="@color/hayu_text_secondary"
            android:textSize="11sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp" />

        <!-- NEGARA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Negara"
            android:textColor="@color/hayu_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/btn_edit_country"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌏"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_edit_country"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pilih Negara"
                android:textColor="@color/hayu_text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textColor="@color/hayu_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- BIO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bio"
            android:textColor="@color/hayu_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_edit_bio"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Tulis sesuatu tentang kamu..."
            android:textColorHint="@color/hayu_text_secondary"
            android:textColor="@color/hayu_text"
            android:textSize="14sp"
            android:background="@drawable/bg_input"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLength="150" />

        <!-- TOMBOL SIMPAN -->
        <TextView
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Simpan Perubahan"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="32dp" />

    </LinearLayout>
</ScrollView>
