<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B9000000"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_menu_card"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H A Y U  •  REWARDS"
            android:textColor="#B9A6FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:gravity="center"
            android:text="🪙"
            android:textSize="70sp"
            android:background="#252044" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hadiah Harian"
            android:textColor="@color/hayu_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login setiap hari dan kumpulkan hadiahmu"
            android:textColor="@color/hayu_text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#252044"
            android:padding="18dp"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HADIAH YANG BISA KAMU DAPATKAN"
                android:textColor="#B9A6FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_coin_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+10 Koin"
                android:textColor="#FFD166"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_coin_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Klaim 1x setiap hari"
                android:textColor="@color/hayu_text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_claim_coin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="🎁   KLAIM SEKARANG"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_close_daily"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Nanti saja"
            android:textColor="@color/hayu_text_secondary"
            android:textSize="13sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
