<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080818">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_home_header">

        <!-- TABS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Milikku"
                android:textColor="#9AA3BD"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Populer"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Event"
                android:textColor="#9AA3BD"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SEARCH BUTTON -->
        <TextView
            android:id="@+id/btn_search_room"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="🔍"
            android:textSize="18sp"
            android:background="@drawable/bg_quick_item"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <!-- CREATE ROOM BUTTON -->
        <LinearLayout
            android:id="@+id/btn_add_room_header_wrap"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btn_add_room_header"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_add_room"
                android:contentDescription="Buat Room" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Buat"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- SEARCH INPUT (hidden by default) -->
    <EditText
        android:id="@+id/et_search_room"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="Cari nama room atau topik..."
        android:textColorHint="#8892AA"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="@drawable/bg_input"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- BANNER (geser) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/banner_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/banner_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- QUICK MENU: Peringkat, CP & BFF, Keluarga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/menu_peringkat"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tile_peringkat"
                    android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peringkat" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"
                        android:shadowColor="#66000000" android:shadowDy="2" android:shadowRadius="3" />
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆" android:textSize="30sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menu_cp_bff"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tile_cp"
                    android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CP&amp;BFF" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"
                        android:shadowColor="#66000000" android:shadowDy="2" android:shadowRadius="3" />
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💕" android:textSize="30sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menu_keluarga"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tile_keluarga">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keluarga" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"
                        android:shadowColor="#66000000" android:shadowDy="2" android:shadowRadius="3" />
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍👩‍👧" android:textSize="30sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- FILTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/filter_populer"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Populer"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_chip_selected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/filter_terbaru"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Terbaru"
                    android:textColor="#9AA3BD"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_chip"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/filter_favorit"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Favorit"
                    android:textColor="#9AA3BD"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_chip" />
            </LinearLayout>

            <!-- ROOM LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- EMPTY STATE -->
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎈"
                    android:textSize="52sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum Ada Room"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap tombol Buat di atas untuk mulai"
                    android:textColor="#8892AA"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
