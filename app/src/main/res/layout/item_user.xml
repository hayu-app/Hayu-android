<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/img_user_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_profile"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:contentDescription="Foto User" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama User"
            android:textColor="@color/hayu_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_user_gender_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👦 20"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_level_badge" />

            <TextView
                android:id="@+id/tv_user_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌏 Indonesia"
                android:textColor="@color/hayu_text_secondary"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_user_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada bio"
            android:textColor="@color/hayu_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
